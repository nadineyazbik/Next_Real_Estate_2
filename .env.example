# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# VITE_ELEVENLABS_AGENT_ID: The public ElevenLabs Conversational AI Agent ID
VITE_ELEVENLABS_AGENT_ID=""

# ELEVENLABS_API_KEY: ElevenLabs API Key used strictly on the server side for /api/tts
ELEVENLABS_API_KEY=""

# ELEVENLABS_VOICE_ID: Optional voice ID for ElevenLabs TTS endpoint
ELEVENLABS_VOICE_ID=""

# AGENT_API_SECRET: Secret key for verifying automated agent webhooks
AGENT_API_SECRET=""

# OWNER_WHATSAPP_NUMBER: Format 961XXXXXXXX (Lebanon country code + number)
OWNER_WHATSAPP_NUMBER="96176743414"

# OWNER_EMAIL: Official company notification email
OWNER_EMAIL="info@nextrealestate.com"

# ADMIN_EMAIL: Administrator login email address
ADMIN_EMAIL="admin@nextrealestate.com"

# ADMIN_PASSWORD: Administrator login password
ADMIN_PASSWORD=""

# OPTIONAL: WhatsApp Cloud API Integration (falls back safely if not set)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""

# OPTIONAL: Cloudflare Turnstile / reCAPTCHA configuration
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""
